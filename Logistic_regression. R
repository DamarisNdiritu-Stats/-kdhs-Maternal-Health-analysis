model_unw <- glm(facility_delivery ~ age_group + parity + education + marital_status +
                   wealth + employment + residence + distance  + media_exposure,
                 data = maternal, family = binomial)
summary(model_unw)
vif_values<-vif(model_unw)
if(is.matrix(vif_values)) {
  vif_table <- data.frame(
    Variable = rownames(vif_values),
    VIF = round(vif_values[,1], 2)
  )
} else {
  vif_table <- data.frame(
    Variable = names(vif_values),
    VIF = round(vif_values, 2)
  )
}

print(vif_table)
View(vif_table)
pR2(model_unw)
