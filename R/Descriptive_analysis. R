library(ggplot2)
library(dplyr)
library(scales)  # for percent_format()

# Function to plot bar chart with percentages
plot_percent_bar <- function(data, var, var_label, title, rotate_x=FALSE) {
  p <- ggplot(data, aes_string(x = var)) +
    geom_bar(aes(y = (..count..)/sum(..count..)), fill = "#1f77b4") +
    ylab("Percentage") +
    xlab(var_label) +
    ggtitle(title) +
    scale_y_continuous(labels = percent_format()) +
    theme_minimal()
  
  if (rotate_x) {
    p <- p + theme(axis.text.x = element_text(angle = 45, hjust = 1))
  }
  
  return(p)
}

